+import type { CstEdit } from "../../../../shared/types/cst";
+import { t } from "../../i18n";
+
+export function object(value: unknown): Record<string, unknown> {
+  return value && typeof value === "object" && !Array.isArray(value) ? Object.fromEntries(Object.entries(value)) : {};
+}
+export function array(value: unknown): unknown[] { return Array.isArray(value) ? value : []; }
+export type EditProps = { disabled: boolean; onEdit: (edit: CstEdit) => void };
+
+/** The unit is taken from CST readback and is never silently converted. */
+export function ValueEditor({ label, value, edit, disabled, onEdit }: EditProps & { label: string; value: unknown; edit: Omit<CstEdit, "value"> }) {
+  return <form className="my-2 flex flex-wrap items-center gap-2 text-sm" data-testid={`edit-${edit.target}-${edit.property}`}
+    onSubmit={(event) => { event.preventDefault(); const form = new FormData(event.currentTarget); onEdit({ ...edit, value: String(form.get("value")) }); }}>
+    <label className="flex items-center gap-2">{label}<input name="value" aria-label={`${edit.target}.${edit.property}`} key={String(value)} defaultValue={String(value)} disabled={disabled} required
+      className="w-28 rounded border bg-background px-2 py-1 disabled:opacity-50" /></label>
+    <span>{edit.unit}</span><button className="rounded border px-2 py-1 disabled:opacity-40" disabled={disabled}>{t("cst.apply")}</button>
+  </form>;
+}
+
+export function LoadEditor({ snapshot, selected, disabled, onEdit }: EditProps & { snapshot: Record<string, unknown>; selected: string }) {
+  const block = array(object(snapshot.schematic).blocks).map(object).find((b) => b.name === selected);
+  const item = array(snapshot.block_properties).map(object).find((b) => b.name === selected);
+  const properties = object(item?.properties);
+  const supported = new Set(["Resistance", "Parasitic Capacitance", "Parasitic Inductance", "Shunt Resistance", "Shunt Capacitance"]);
+  return <div className="mt-3 rounded border p-3"><strong>{selected}</strong><p className="text-xs">{String(block?.type_name ?? t("cst.probe"))}</p>
+    {Object.entries(properties).map(([name, raw]) => { const p = object(raw); return block?.type_short === "RES" && supported.has(name) && p.type === "double"
+      ? <ValueEditor key={name} label={name} value={p.value} edit={{ kind: "load", target: selected, property: name, unit: String(p.unit) }} disabled={disabled} onEdit={onEdit} />
+      : <p key={name} className="text-xs">{name}: {String(p.value)} {String(p.unit ?? "")}</p>; })}
+    <p className="mt-2 text-xs text-muted-foreground">{t("cst.loadHint")}</p>
+  </div>;
+}
+
+export function CstSettings({ snapshot, disabled, onEdit }: EditProps & { snapshot: Record<string, unknown> }) {
+  const units = object(snapshot.units), frequency = object(snapshot.frequency);
+  return <div className="space-y-4">
+    <section className="rounded border p-3"><strong>{t("cst.parameters")}</strong>
+      {array(object(snapshot.parameters).parameters).map(object).map((p) => <ValueEditor key={String(p.name)} label={String(p.name)} value={p.expression}
+        edit={{ kind: "parameter", target: String(p.name), property: "expression" }} disabled={disabled} onEdit={onEdit} />)}
+    </section>
+    <section className="rounded border p-3"><strong>{String(snapshot.solver)}</strong><p className="text-xs">{JSON.stringify(units)}</p>
+      {["min", "max"].map((name) => <ValueEditor key={name} label={name === "min" ? t("cst.freqMin") : t("cst.freqMax")} value={frequency[name]}
+        edit={{ kind: "frequency", target: "Solver", property: name, unit: String(units.Frequency) }} disabled={disabled} onEdit={onEdit} />)}
+      <p className="text-xs text-muted-foreground">{t("cst.solverReadOnly")}</p>
+    </section>
+    {array(snapshot.tasks).map(object).map((task) => <section key={String(task.name)} className="rounded border p-3">
+      <strong>{String(task.name)} · {String(task.type)}</strong>
+      {String(task.type).toLowerCase() === "transient" && <ValueEditor label="tmax" value={object(task.properties).tmax}
+        edit={{ kind: "task", target: String(task.name), property: "tmax", unit: String(units.Time) }} disabled={disabled} onEdit={onEdit} />}
+      <dl className="text-xs">{Object.entries(object(task.properties)).filter(([name]) => name !== "tmax").map(([name,value]) => <div key={name}><dt className="inline font-medium">{name}: </dt><dd className="inline">{String(value)}</dd></div>)}</dl>
+      <p className="mt-2 text-xs text-muted-foreground">{t("cst.taskHint")}</p>
+    </section>)}
+    <section className="rounded border p-3"><strong>{t("cst.excitation")}</strong><pre className="whitespace-pre-wrap text-xs">{JSON.stringify({ plane_wave: snapshot.plane_wave, signals: snapshot.user_signals, ports: snapshot.ports, probes: snapshot.field_probes }, null, 2)}</pre>
+      <p className="text-xs text-muted-foreground">{t("cst.excitationReadOnly")}</p>
+    </section>
+  </div>;
+}

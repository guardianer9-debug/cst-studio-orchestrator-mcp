+  compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022 },
+}).outputText, { module, exports: module.exports });
+const { chooseCstProject } = module.exports;
+
+test("Agent new version becomes selected when following the backend", () => {
+  assert.equal(chooseCstProject({ projects: [{ path: "old" }, { path: "new" }], active_project: "new", recommended_project: "old" }, "old", true), "new");
+});

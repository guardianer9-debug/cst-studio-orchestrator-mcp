+import { createHash } from "node:crypto";
 import type { CstAction, CstArtifact, CstSelection, CstWorkspace } from "../../shared/types/cst";
 
 const execute = promisify(execFile);
 type SessionLocation = { projectPath: string; createdAt: number };
 
+/** Bound native workspaces survive draft-chat cleanup without moving Pi JSONL. */
+export async function hasCstSessionBinding(project: string, id: string): Promise<boolean> {
+  const key = createHash("sha256").update(id).digest("hex").slice(0, 24);
+  try {
+    const value: { session_id?: string } = JSON.parse(await readFile(join(project, ".cst-sessions", key + ".json"), "utf8"));
+    return value.session_id === id;
+  } catch (error) {
+    if (error && typeof error === "object" && "code" in error && error.code === "ENOENT") return false;
+    // On an I/O/format failure retain identity for recovery instead of deleting it.
+    return true;
+  }
+}
+
+/** Catalog loads before ProjectStore's deferred UI load; use the saved project map. */
+export async function retainBoundCstDraft(userData: string, projectId: string, id: string): Promise<boolean> {
+  try {
+    const projects: { id: string; path: string }[] = JSON.parse(await readFile(join(userData, "projects.json"), "utf8"));
+    if (!Array.isArray(projects)) return true;
+    const project = projects.find((p) => p.id === projectId);
+    return project ? hasCstSessionBinding(project.path, id) : false;
+  } catch { return true; } // Retain on uncertain startup I/O; never discard native-work identity.
+}

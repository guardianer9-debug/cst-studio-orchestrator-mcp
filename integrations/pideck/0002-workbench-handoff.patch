@@ -0,0 +1,11 @@
+import type { CstWorkspace } from "../../../../shared/types/cst";
+
+/** Follow committed backend versions, while explicit historical selection stays pinned. */
+export function chooseCstProject(index: CstWorkspace | null, current: string, follow: boolean): string {
+  if (!index) return "";
+  const valid = new Set(index.projects.map((p) => p.path));
+  if (!follow && valid.has(current)) return current;
+  if (follow && index.active_project && valid.has(index.active_project)) return index.active_project;
+  if (index.recommended_project && valid.has(index.recommended_project)) return index.recommended_project;
+  return valid.has(current) ? current : index.projects[0]?.path ?? "";
+}

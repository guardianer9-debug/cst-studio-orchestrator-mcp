new file mode 100644
index 0000000..9de4b46
--- /dev/null
+++ b/src/main/cst/CstWorkspaceService.ts
@@ -0,0 +1,114 @@
+import { execFile } from "node:child_process";
+import { readFile, realpath } from "node:fs/promises";
+import { join, relative, isAbsolute, dirname } from "node:path";
+import { promisify } from "node:util";
+import type { CstAction, CstArtifact, CstSelection, CstWorkspace } from "../../shared/types/cst";
+
+const execute = promisify(execFile);
+type SessionLocation = { projectPath: string; createdAt: number };
+
+/** Native CST files stay in Python's session index; PiDeck owns only UI/IPC. */
+export class CstWorkspaceService {
+  constructor(private readonly locate: (id: string) => SessionLocation | undefined) {}
+
+  private async context(id: string) {
+    if (typeof id !== "string" || !id) throw new Error("CST_SESSION_REQUIRED");
+    const session = this.locate(id);
+    if (!session) throw new Error("CST_SESSION_NOT_FOUND");
+    let raw: string;
+    try { raw = await readFile(join(session.projectPath, ".cst-workspace.json"), "utf8"); }
+    catch (error) { if (error instanceof Error && "code" in error && error.code === "ENOENT") return null; throw error; }
+    const config: { python: string; source: string } = JSON.parse(raw);
+    if (typeof config.python !== "string" || !isAbsolute(config.python) || typeof config.source !== "string" || !isAbsolute(config.source)) {
+      throw new Error("CST_INVALID_LOCAL_CONFIGURATION");
+    }
+    return { ...session, config };
+  }
+
+  private async call(id: string, module: string, action: string): Promise<string | null> {
+    const context = await this.context(id);
+    if (!context) return null;
+    const result = await execute(context.config.python, ["-m", module, action,
+      "--project", context.projectPath, "--session", id, "--created", String(context.createdAt / 1000)],
+      { windowsHide: true, timeout: 30000, maxBuffer: 16 * 1024 * 1024,
+        env: { ...process.env, PYTHONUTF8: "1", PYTHONPATH: context.config.source } });
+    return result.stdout;
+  }
+
+  async index(id: string): Promise<CstWorkspace | null> {
+    const raw = await this.call(id, "mcp_cst_studio.session_workspace", "inventory");
+    if (!raw) return null;
+    const value: CstWorkspace = JSON.parse(raw);
+    if (value.session_id !== id || !Array.isArray(value.projects)) throw new Error("CST_INVALID_INDEX");
+    return value;
+  }
+
+  async selected(input: CstSelection) {
+    if (!input || typeof input.sessionId !== "string" || typeof input.project !== "string") throw new Error("CST_INVALID_SELECTION");
+    const index = await this.index(input.sessionId);
+    const item = index?.projects.find((p) => p.path === input.project);
+    if (!index || !item) throw new Error("CST_PROJECT_NOT_IN_SESSION");
+    await this.confined(index.directory, item.path);
+    return { index, item };
+  }
+
+  private async confined(root: string, path: string) {
+    const resolved = await realpath(path);
+    const rel = relative(await realpath(root), resolved);
+    if (rel.startsWith("..") || isAbsolute(rel)) throw new Error("CST_PATH_ESCAPES_SESSION");
+    return resolved;
+  }
+
+  /** Filesystem refresh does not start CST, a task, mesh generation or a provider. */
+  async artifact(input: CstSelection): Promise<CstArtifact | null> {
+    const { index, item } = await this.selected(input);
+    const path = item.snapshot_current ? item.snapshot : item.historical_snapshot;
+    if (!path) return null;
+    const safe = await this.confined(index.directory, path);
+    const snapshot: Record<string, unknown> = JSON.parse(await readFile(safe, "utf8"));
+    const folder = dirname(safe);
+    const meshes: CstArtifact["meshes"] = [];
+    // Asset names are restricted to the snapshot directory, never renderer paths.
+    const cad = snapshot.cad;
+    if (cad && typeof cad === "object" && "meshes" in cad && Array.isArray(cad.meshes)) {
+      for (const mesh of cad.meshes) {
+        if (typeof mesh.file !== "string" || typeof mesh.object !== "string") continue;
+        const data = await readFile(await this.confined(folder, join(folder, mesh.file)));
+        const vertices: number[] = [];
+        const count = data.length >= 84 ? data.readUInt32LE(80) : 0;
+        if (84 + count * 50 === data.length) {
+          for (let n = 0; n < count; n++) for (let k = 0; k < 9; k++) vertices.push(data.readFloatLE(84 + n * 50 + 12 + k * 4));
+        } else {
+          for (const match of data.toString("utf8").matchAll(/vertex\s+([-+\d.eE]+)\s+([-+\d.eE]+)\s+([-+\d.eE]+)/g)) {
+            vertices.push(Number(match[1]), Number(match[2]), Number(match[3]));
+          }
+        }
+        meshes.push({ name: mesh.object, vertices });
+      }
+    }
+    const curves: Record<string, unknown>[] = [];
+    if (Array.isArray(snapshot.curves)) for (const curve of snapshot.curves) {
+      if (typeof curve.file === "string") curves.push(JSON.parse(await readFile(await this.confined(folder, join(folder, curve.file)), "utf8")));
+    }
+    return { snapshot, meshes, curves, historical: !item.snapshot_current };
+  }
+
+  /** Both human controls and Pi connect to this same session-owned dispatcher. */
+  async action(input: CstAction): Promise<unknown> {
+    await this.selected(input);
+    const allowed = new Set(["cst_open_project", "cst_reload_project", "cst_close_project", "cst_refresh_view", "cst_refresh_results", "cst_readback", "cst_save_project", "cst_set_parameter", "cst_connection_status"]);
+    if (!allowed.has(input.tool) || !input.arguments || typeof input.arguments !== "object") throw new Error("CST_ACTION_NOT_ALLOWED");
+    if (["cst_open_project", "cst_reload_project"].includes(input.tool) && input.arguments.path !== input.project) throw new Error("CST_SELECTION_MISMATCH");
+    if (input.tool === "cst_save_project" && input.arguments.path) throw new Error("CST_SAVE_AS_REQUIRES_VERSION_WORKFLOW");
+    const raw = await this.call(input.sessionId, "mcp_cst_studio.workbench_service", "ensure");
+    if (!raw) throw new Error("CST_NOT_CONFIGURED");
+    const backend: { url: string; token: string; session_id: string } = JSON.parse(raw);
+    if (!/^http:\/\/127\.0\.0\.1:\d+$/.test(backend.url) || backend.session_id !== input.sessionId) throw new Error("CST_INVALID_BACKEND");
+    const response = await fetch(backend.url + "/action", { method: "POST",
+      headers: { "Content-Type": "application/json", Authorization: "Bearer " + backend.token },
+      body: JSON.stringify({ tool: input.tool, arguments: input.arguments, project: input.project }), signal: AbortSignal.timeout(120000) });
+    const result: unknown = await response.json();
+    if (!response.ok) throw new Error(JSON.stringify(result));
+    return result;
+  }
+}

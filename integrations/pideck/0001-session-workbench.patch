+import { ipcMain, shell } from "electron";
+import { ipcChannels } from "../../shared/ipc";
+import { CstWorkspaceService } from "../cst/CstWorkspaceService";
+import type { SessionCatalog } from "../sessions/SessionCatalog";
+import type { ProjectStore } from "../projects/ProjectStore";
+import type { CstAction, CstSelection } from "../../shared/types/cst";
+
+/** Renderer sends stable identities, never arbitrary filesystem or process commands. */
+export function registerCstIpc(catalog: SessionCatalog, projects: ProjectStore) {
+  const service = new CstWorkspaceService((id) => {
+    const session = catalog.get(id);
+    const project = session && projects.get(session.projectId);
+    return session && project ? { projectPath: project.path, createdAt: session.createdAt } : undefined;
+  });
+  ipcMain.handle(ipcChannels.cstIndex, (_event, id: string) => service.index(id));
+  ipcMain.handle(ipcChannels.cstOpenFolder, async (_event, id: string) => {
+    const index = await service.index(id);
+    if (!index) throw new Error("CST_NOT_CONFIGURED");
+    const error = await shell.openPath(index.directory);
+    if (error) throw new Error(error);
+  });
+  ipcMain.handle(ipcChannels.cstReveal, async (_event, input: CstSelection) => {
+    const { item } = await service.selected(input);
+    shell.showItemInFolder(item.path);
+  });
+  ipcMain.handle(ipcChannels.cstArtifact, (_event, input: CstSelection) => service.artifact(input));
+  ipcMain.handle(ipcChannels.cstAction, (_event, input: CstAction) => service.action(input));
+}

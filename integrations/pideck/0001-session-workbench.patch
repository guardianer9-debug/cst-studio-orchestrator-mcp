+++ b/src/shared/types/cst.ts
@@ -0,0 +1,17 @@
+/** Native project identity travels with every workbench request. */
+export type CstProject = {
+  path: string; label: string; sha256: string; native_directory: string;
+  snapshot?: string; snapshot_current: boolean; status?: string;
+  result_origin: string; result_binding: string; result_note?: string;
+  historical_snapshot?: string;
+};
+export type CstWorkspace = {
+  session_id: string; directory: string; entry: string; title: string;
+  recommended_project: string | null; projects: CstProject[];
+};
+export type CstSelection = { sessionId: string; project: string };
+export type CstAction = CstSelection & {
+  tool: string; arguments: Record<string, unknown>;
+};
+export type CstArtifact = { snapshot: Record<string, unknown>; meshes: { name: string; vertices: number[] }[];
+  curves: Record<string, unknown>[]; historical: boolean };
diff --git a/tests/cstWorkspace.test.mjs b/tests/cstWorkspace.test.mjs
new file mode 100644
index 0000000..ca6eb13
--- /dev/null
+++ b/tests/cstWorkspace.test.mjs
@@ -0,0 +1,59 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { mkdtemp, mkdir, writeFile, rm } from "node:fs/promises";
+import { readFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { createRequire } from "node:module";
+import vm from "node:vm";
+import ts from "typescript";
+
+const require = createRequire(import.meta.url);
+function load(fakeExec) {
+  fakeExec[require("node:util").promisify.custom] = (...args) => new Promise((resolve, reject) => fakeExec(...args, (error, stdout, stderr) => error ? reject(error) : resolve({ stdout, stderr })));
+  const source = readFileSync("src/main/cst/CstWorkspaceService.ts", "utf8");
+  const output = ts.transpileModule(source, { compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022 } }).outputText;
+  const module = { exports: {} };
+  vm.runInNewContext(output, { module, exports: module.exports, process, AbortSignal, Set,
+    require: (name) => name === "node:child_process" ? { execFile: fakeExec } : require(name),
+    fetch: () => { throw new Error("unexpected backend call"); } });
+  return module.exports.CstWorkspaceService;
+}
+
+test("CST index uses the stable session identity and rejects another session's project", async () => {
+  const root = await mkdtemp(join(tmpdir(), "cst-workspace-"));
+  try {
+    await writeFile(join(root, ".cst-workspace.json"), JSON.stringify({ python: join(root, "python.exe"), source: root }));
+    const first = join(root, "sessions", "a"), second = join(root, "sessions", "b");
+    await mkdir(first, { recursive: true }); await mkdir(second, { recursive: true });
+    await writeFile(join(first, "model.cst"), "native a"); await writeFile(join(second, "model.cst"), "native b");
+    const calls = [];
+    const Service = load((_exe, args, options, callback) => {
+      const id = args[args.indexOf("--session") + 1]; calls.push({ id, args, options });
+      callback(null, JSON.stringify({ session_id: id, directory: id === "a" ? first : second,
+        projects: [{ path: join(id === "a" ? first : second, "model.cst") }] }), "");
+    });
+    const service = new Service((id) => ["a", "b"].includes(id) ? { projectPath: root, createdAt: 1000 } : undefined);
+    assert.equal((await service.index("a")).directory, first);
+    assert.equal((await service.index("b")).directory, second);
+    await assert.rejects(service.selected({ sessionId: "a", project: join(second, "model.cst") }), /NOT_IN_SESSION/);
+    await assert.rejects(service.index("missing"), /NOT_FOUND/);
+    assert.ok(calls.every((call) => call.args[2] === "inventory" && call.options.windowsHide));
+    assert.ok(calls.every((call) => !call.args.includes("serve")));
+  } finally { await rm(root, { recursive: true, force: true }); }
+});
+
+test("CST refresh refuses an artifact escaping its session and never calls a backend", async () => {
+  const root = await mkdtemp(join(tmpdir(), "cst-artifact-"));
+  try {
+    await writeFile(join(root, ".cst-workspace.json"), JSON.stringify({ python: join(root, "python.exe"), source: root }));
+    const session = join(root, "session"); await mkdir(session);
+    const project = join(session, "x.cst"); await writeFile(project, "native");
+    const external = join(root, "external.json"); await writeFile(external, "{}");
+    const Service = load((_exe, args, options, callback) => callback(null, JSON.stringify({ session_id: "a", directory: session,
+      projects: [{ path: project, snapshot_current: true, snapshot: external }] }), ""));
+    const service = new Service(() => ({ projectPath: root, createdAt: 1000 }));
+    await assert.rejects(service.artifact({ sessionId: "a", project }), /ESCAPES_SESSION/);
+    await assert.rejects(service.action({ sessionId: "a", project, tool: "cst_run_task", arguments: {} }), /ACTION_NOT_ALLOWED/);
+  } finally { await rm(root, { recursive: true, force: true }); }
+});

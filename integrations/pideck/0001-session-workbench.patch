+import { useCallback, useEffect, useRef, useState, type ReactNode } from "react";
+import type { CstArtifact, CstWorkspace } from "../../../../shared/types/cst";
+import { desktopApi as api } from "../../desktopApi";
+import { t } from "../../i18n";
+import { ResizableHandle, ResizablePanel, ResizablePanelGroup } from "../../components/ui-shadcn/resizable";
+import { CstCad, CstCurves, CstSchematic, list, record } from "./CstVisuals";
+
+/** The session key remounts this owner, so late responses cannot retarget another chat. */
+export function CstSessionWorkspace({ sessionId, children }: { sessionId?: string; children: ReactNode }) {
+  return sessionId ? <SessionWorkbench key={sessionId} sessionId={sessionId}>{children}</SessionWorkbench> : children;
+}
+
+function SessionWorkbench({ sessionId, children }: { sessionId: string; children: ReactNode }) {
+  const [index, setIndex] = useState<CstWorkspace | null>(null);
+  const [selected, setSelected] = useState("");
+  const [artifact, setArtifact] = useState<CstArtifact | null>(null);
+  const [tab, setTab] = useState("3d");
+  const [open, setOpen] = useState(true);
+  const [busy, setBusy] = useState(false);
+  const [message, setMessage] = useState("");
+  const generation = useRef(0);
+  const alive = useRef(true);
+  useEffect(() => { alive.current = true; return () => { alive.current = false; generation.current++; }; }, []);
+  const reload = useCallback(async () => {
+    const current = ++generation.current;
+    const value = await api.cst.index(sessionId);
+    if (!alive.current || current !== generation.current) return;
+    setIndex(value);
+    setSelected((old) => value?.projects.some((p) => p.path === old) ? old : value?.recommended_project ?? value?.projects[0]?.path ?? "");
+  }, [sessionId]);
+  useEffect(() => { void reload().catch((e) => setMessage(String(e))); }, [reload]);
+  useEffect(() => {
+    let cancelled = false;
+    setArtifact(null);
+    if (selected) void api.cst.artifact({ sessionId, project: selected }).then((data) => {
+      if (!cancelled) setArtifact(data);
+    }).catch((e) => { if (!cancelled) setMessage(String(e)); });
+    return () => { cancelled = true; };
+  }, [sessionId, selected, index]);
+  const item = index?.projects.find((p) => p.path === selected);
+  async function act(tool: string, args: Record<string, unknown> = {}) {
+    setBusy(true); setMessage("");
+    try {
+      const result = record(await api.cst.action({ sessionId, project: selected, tool, arguments: args }));
+      const content = list(result.content).map(record);
+      setMessage(content.map((c) => String(c.text ?? "")).join("\n"));
+      await reload();
+      if (alive.current && typeof result.active_project === "string") setSelected(result.active_project);
+    } catch (e) { if (alive.current) setMessage(String(e)); }
+    finally { if (alive.current) setBusy(false); }
+  }
+  const button = "rounded border px-2 py-1 text-xs disabled:opacity-40";
+  if (!index) return <>{children}</>;
+  const body = <section className="flex h-full min-h-0 flex-col overflow-hidden bg-background" data-testid="cst-workbench">
+    <div className="flex flex-wrap items-center gap-2 border-b p-2">
+      <strong className="text-sm">{t("cst.title")}</strong>
+      <button className={button} onClick={() => void api.cst.openFolder(sessionId).catch((e) => setMessage(String(e)))}>{t("cst.openFolder")}</button>
+      <button className={button} onClick={() => void reload()}>{t("cst.refreshFiles")}</button>
+      <button className={button} onClick={() => setOpen(false)}>{t("cst.hide")}</button>
+    </div>
+    <div className="space-y-2 border-b p-2 text-xs">
+      <p className="break-all text-muted-foreground">{index.directory}</p>
+      <select className="w-full rounded border bg-background p-1" value={selected} disabled={busy} onChange={(e) => setSelected(e.target.value)}>
+        {index.projects.map((p) => <option key={p.path} value={p.path}>{p.label}</option>)}
+      </select>
+      <p className="break-all" data-testid="cst-project-path">{selected}</p>
+      <p>{t("cst.paused")}</p>
+      <div className="flex flex-wrap gap-2">
+        <button className={button} disabled={!item} onClick={() => void api.cst.reveal({ sessionId, project: selected }).catch((e) => setMessage(String(e)))}>{t("cst.locate")}</button>
+        <button className={button} disabled={busy || !item} onClick={() => void act("cst_open_project", { path: selected })}>{t("cst.connect")}</button>
+        <button className={button} disabled={busy || !item} onClick={() => void act("cst_reload_project", {path:selected})}>{t("cst.readActual")}</button>
+        <button className={button} disabled={busy || !item} onClick={() => void act("cst_refresh_results", {origin:"unknown"})}>{t("cst.readResults")}</button>
+        <button className={button} disabled={busy || !item} onClick={() => void act("cst_refresh_results", {origin:"manual"})}>{t("cst.readManualResults")}</button>
+        <button className={button} disabled={busy || !item} onClick={() => void act("cst_save_project")}>{t("cst.save")}</button>
+        <button className={button} disabled={busy || !item} onClick={() => void act("cst_close_project")}>{t("cst.release")}</button>
+      </div>
+      <p>{item?.result_origin} · {item?.result_binding} · {item?.result_note}</p>
+      {artifact?.historical && <p className="text-amber-500">{t("cst.historical")}</p>}
+      {artifact && <p>{t("cst.observedAt")} {new Date(Number(artifact.snapshot.read_at) * 1000).toLocaleString()}</p>}
+      {message && <details open><summary>{t("cst.receipt")}</summary><pre className="max-h-36 overflow-auto whitespace-pre-wrap">{message}</pre></details>}
+    </div>
+    <nav className="flex gap-2 border-b p-2">{[{name:"3d",label:t("cst.tab.3d")},{name:"mesh",label:t("cst.tab.mesh")},{name:"schematic",label:t("cst.tab.schematic")},{name:"settings",label:t("cst.tab.settings")},{name:"results",label:t("cst.tab.results")}].map(({name,label}) => <button key={name} className={`${button} ${tab === name ? "bg-accent" : ""}`} onClick={() => setTab(name)}>{label}</button>)}</nav>
+    <div className="min-h-0 flex-1 overflow-auto p-3">
+      {!artifact ? <p className="text-sm">{t("cst.noSnapshot")}</p> : <>
+        {tab === "3d" && <CstCad meshes={artifact.meshes} cable={artifact.snapshot.cable} />}
+        {tab === "schematic" && <CstSchematic snapshot={artifact.snapshot} />}
+        {tab === "mesh" && <><p>{t("cst.meshPending")}</p><pre>{JSON.stringify({ cells: artifact.snapshot.mesh_cells, source: "CST readback" }, null, 2)}</pre></>}
+        {tab === "results" && <CstCurves curves={artifact.curves} />}
+        {tab === "settings" && <>
+          <p className="text-xs">{t("cst.parameterHint")}</p>
+          {list(record(artifact.snapshot.parameters).parameters).map((p) => { const param = record(p); return <form key={String(param.name)} className="my-2 flex gap-2 text-xs"
+            onSubmit={(e) => { e.preventDefault(); const data = new FormData(e.currentTarget); void act("cst_set_parameter", { name: param.name, value: data.get("value") }); }}>
+            <label>{String(param.name)}<input name="value" className="ml-2 rounded border bg-background p-1" defaultValue={String(param.expression)} key={String(param.expression)} /></label>
+            <button className={button} disabled={busy || artifact.historical}>{t("cst.apply")}</button></form>; })}
+          <pre className="whitespace-pre-wrap text-xs">{JSON.stringify({ units: artifact.snapshot.units, frequency: artifact.snapshot.frequency, solver: artifact.snapshot.solver, tasks: artifact.snapshot.tasks, plane_wave: artifact.snapshot.plane_wave, probes: artifact.snapshot.field_probes }, null, 2)}</pre>
+        </>}
+      </>}
+    </div>
+  </section>;
+  return <div className="flex h-full min-h-0 flex-col">
+    {!open && <div className="flex gap-2 border-b p-2"><button className={button} onClick={() => setOpen(true)}>{t("cst.title")}</button><button className={button} onClick={() => void api.cst.openFolder(sessionId)}>{t("cst.openFolder")}</button></div>}
+    {open ? <ResizablePanelGroup orientation="horizontal" className="min-h-0 flex-1"><ResizablePanel defaultSize="38%" minSize="20%">{children}</ResizablePanel><ResizableHandle withHandle /><ResizablePanel defaultSize="62%" minSize="30%">{body}</ResizablePanel></ResizablePanelGroup> : children}
+  </div>;
+}
diff --git a/src/renderer/src/features/cst/CstVisuals.tsx b/src/renderer/src/features/cst/CstVisuals.tsx
new file mode 100644
index 0000000..2ba37a3
--- /dev/null
+++ b/src/renderer/src/features/cst/CstVisuals.tsx
@@ -0,0 +1,109 @@
+import { useEffect, useRef, useState } from "react";
+import type { CstArtifact } from "../../../../shared/types/cst";
+import { t } from "../../i18n";
+
+export function record(value: unknown): Record<string, unknown> {
+  return value && typeof value === "object" && !Array.isArray(value) ? Object.fromEntries(Object.entries(value)) : {};
+}
+export function list(value: unknown): unknown[] { return Array.isArray(value) ? value : []; }
+
+/** Orthographic CAD preview from real STL triangles, never a solver-mesh surrogate. */
+export function CstCad({ meshes, cable }: Pick<CstArtifact, "meshes"> & { cable?: unknown }) {
+  const canvas = useRef<HTMLCanvasElement>(null);
+  const [angle, setAngle] = useState([.6, -.55]);
+  const [hidden, setHidden] = useState<string[]>([]);
+  const [opacity, setOpacity] = useState(.3);
+  const [zoom, setZoom] = useState(1);
+  useEffect(() => {
+    const element = canvas.current;
+    if (!element) return;
+    const ctx = element.getContext("2d");
+    if (!ctx) return;
+    ctx.clearRect(0, 0, 900, 580);
+    const all = meshes.flatMap((m) => m.vertices);
+    const min = [Infinity, Infinity, Infinity], max = [-Infinity, -Infinity, -Infinity];
+    all.forEach((v, i) => { min[i % 3] = Math.min(min[i % 3], v); max[i % 3] = Math.max(max[i % 3], v); });
+    const center = min.map((v, i) => (v + max[i]) / 2);
+    const scale = 350 * zoom / Math.max(...max.map((v, i) => v - min[i]), 1);
+    function project(x: number, y: number, z: number) {
+      x -= center[0]; y -= center[1]; z -= center[2];
+      const xx = x * Math.cos(angle[0]) - y * Math.sin(angle[0]);
+      const yy = x * Math.sin(angle[0]) + y * Math.cos(angle[0]);
+      return [450 + xx * scale, 290 - (z * Math.cos(angle[1]) - yy * Math.sin(angle[1])) * scale];
+    }
+    meshes.forEach((mesh, index) => {
+      if (hidden.includes(mesh.name)) return;
+      ctx.fillStyle = `hsla(${195 + index * 35},65%,60%,${opacity})`;
+      ctx.strokeStyle = `hsla(${195 + index * 35},75%,55%,.5)`;
+      for (let n = 0; n + 8 < mesh.vertices.length; n += 9) {
+        ctx.beginPath();
+        for (let k = 0; k < 3; k++) {
+          const p = project(mesh.vertices[n + k * 3], mesh.vertices[n + k * 3 + 1], mesh.vertices[n + k * 3 + 2]);
+          if (k === 0) ctx.moveTo(p[0], p[1]); else ctx.lineTo(p[0], p[1]);
+        }
+        ctx.closePath(); ctx.fill(); ctx.stroke();
+      }
+    });
+    const harness = record(cable);
+    const knots = new Map(list(harness.knots).map((value) => { const knot = record(value); return [String(knot.id), list(knot.position).map(Number)]; }));
+    ctx.strokeStyle = "#f97316"; ctx.lineWidth = 3;
+    for (const route of list(harness.routes).map(record)) {
+      ctx.beginPath();
+      list(route.knots).forEach((id, n) => { const position = knots.get(String(id)); if (!position || position.length !== 3) return;
+        const p = project(position[0], position[1], position[2]); if (n === 0) ctx.moveTo(p[0], p[1]); else ctx.lineTo(p[0], p[1]); });
+      ctx.stroke();
+    }
+    ctx.lineWidth = 1;
+  }, [meshes, cable, angle, hidden, opacity, zoom]);
+  return <div>
+    <p className="text-xs text-muted-foreground">{t("cst.cadHint")}</p>
+    <canvas ref={canvas} width={900} height={580} className="w-full cursor-grab rounded border"
+      onPointerDown={(e) => e.currentTarget.setPointerCapture(e.pointerId)}
+      onPointerMove={(e) => { if (e.buttons === 1) setAngle((old) => [old[0] + e.movementX * .01, old[1] + e.movementY * .01]); }}
+      onWheel={(e) => setZoom((old) => Math.max(.2, Math.min(6, old * (e.deltaY > 0 ? .9 : 1.1))))} />
+    <label className="text-xs">{t("cst.opacity")} <input type="range" min={.05} max={1} step={.05} value={opacity} onChange={(e) => setOpacity(Number(e.target.value))} /></label>
+    {meshes.map((m) => <label key={m.name} className="block text-xs"><input type="checkbox" checked={!hidden.includes(m.name)}
+      onChange={() => setHidden((old) => old.includes(m.name) ? old.filter((x) => x !== m.name) : [...old, m.name])} /> {m.name}</label>)}
+  </div>;
+}
+
+/** Connection topology and pin labels come from actual CST readback, not a template. */
+export function CstSchematic({ snapshot }: Pick<CstArtifact, "snapshot">) {
+  const schematic = record(snapshot.schematic);
+  const blocks = list(schematic.blocks).map(record);
+  const probes = list(snapshot.circuit_probes).map(record);
+  const nets = list(schematic.nets).map(record);
+  const names = [...blocks, ...probes].map((b) => String(b.name));
+  const positions = new Map(names.map((name, i) => [name, [110 + i % 3 * 240, 90 + Math.floor(i / 3) * 130]]));
+  return <div><p className="text-xs text-muted-foreground">{t("cst.schematicHint")}</p>
+    <svg viewBox="0 0 740 450" className="w-full rounded border">
+      {nets.map((net) => { const ports = list(net.ports).map(list); const a = positions.get(String(ports[0]?.[1])); const b = positions.get(String(ports[1]?.[1]));
+        return a && b ? <g key={String(net.name)}><line x1={a[0]} y1={a[1]} x2={b[0]} y2={b[1]} stroke="#38bdf8" />
+          <text x={(a[0] + b[0]) / 2} y={(a[1] + b[1]) / 2 - 7} fill="currentColor" fontSize="10">{String(net.name)}</text></g> : null; })}
+      {names.map((name) => { const p = positions.get(name)!; return <g key={name}>
+        <rect x={p[0] - 45} y={p[1] - 20} width="90" height="40" rx="7" fill="#172f44" stroke="#64748b" />
+        <text x={p[0]} y={p[1] + 4} textAnchor="middle" fill="white" fontSize="12">{name}</text></g>; })}
+    </svg>
+    <table className="w-full text-xs"><tbody>{nets.map((n) => <tr key={String(n.name)}><td>{String(n.name)}</td><td>{list(n.ports).map((p) => list(p).join(" : ")).join(" ↔ ")}</td></tr>)}</tbody></table>
+    <pre className="mt-3 whitespace-pre-wrap text-xs">{JSON.stringify(snapshot.block_properties, null, 2)}</pre>
+  </div>;
+}
+
+export function CstCurves({ curves }: Pick<CstArtifact, "curves">) {
+  if (!curves.length) return <p>{t("cst.noResults")}</p>;
+  return <div>{curves.map((curve, i) => {
+    const data = record(curve.data);
+    const x = list(data.x).map(Number), real = list(data.real ?? data.y).map(Number), imag = list(data.imag).map(Number);
+    const parameter = String(curve.tree_path).includes("S-Parameters");
+    const y = real.map((v, n) => parameter ? 20 * Math.log10(Math.max(1e-15, Math.hypot(v, imag[n] ?? 0))) : v);
+    if (!x.length || x.length !== y.length) return <pre key={i}>{JSON.stringify(curve, null, 2)}</pre>;
+    const lo = Math.min(...y), hi = Math.max(...y), xmin = Math.min(...x), xmax = Math.max(...x);
+    const points = x.map((v, n) => `${50 + 630 * (v - xmin) / (xmax - xmin || 1)},${250 - 210 * (y[n] - lo) / (hi - lo || 1)}`).join(" ");
+    return <div key={i} className="mb-4"><p className="text-xs">{String(curve.tree_path)} · CST run_id={String(curve.run_id)} {parameter ? "|S11| dB" : String(curve.quantity ?? curve.ylabel ?? "")}</p>
+      <svg viewBox="0 0 720 290" className="w-full border"><line x1="50" y1="40" x2="50" y2="250" stroke="currentColor" /><line x1="50" y1="250" x2="680" y2="250" stroke="currentColor" />
+        <polyline points={points} fill="none" stroke="#38bdf8" strokeWidth="2" />
+        <text x="5" y="45" fill="currentColor" fontSize="12">{hi.toPrecision(4)}</text><text x="5" y="250" fill="currentColor" fontSize="12">{lo.toPrecision(4)}</text>
+        <text x="50" y="270" fill="currentColor" fontSize="12">{xmin.toPrecision(4)}</text><text x="610" y="270" fill="currentColor" fontSize="12">{xmax.toPrecision(4)}</text>
+        <text x="300" y="287" fill="currentColor" fontSize="12">{String(curve.xlabel ?? "")}</text></svg></div>;
+  })}</div>;
+}

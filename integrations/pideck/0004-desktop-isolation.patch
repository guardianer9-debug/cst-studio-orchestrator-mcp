index 0000000..4403f46
--- /dev/null
+++ b/src/main/logging/lifecycleDiagnostics.ts
@@ -0,0 +1,37 @@
+import type { App } from "electron";
+import { appendFileSync, mkdirSync } from "node:fs";
+import { join } from "node:path";
+
+/** Rare lifecycle events use synchronous writes: the async app log can be lost at exit.
+ * No prompts, command-line arguments, environment variables or credentials are recorded.
+ * A hard kill cannot execute these handlers; the external launcher records its exit code.
+ */
+export function registerLifecycleDiagnostics(app: App, runtime = process): void {
+	const directory = join(app.getPath("userData"), "logs");
+	const write = (event: string, detail: Record<string, unknown> = {}) => {
+		try {
+			const time = new Date().toISOString();
+			mkdirSync(directory, { recursive: true });
+			appendFileSync(join(directory, `lifecycle-${time.slice(0, 10)}.jsonl`),
+				`${JSON.stringify({ time, pid: runtime.pid, event, ...detail })}\n`, "utf8");
+		} catch {
+			// Logging failures must not change application shutdown/recovery behavior.
+		}
+	};
+	write("startup", { version: app.getVersion(), electron: runtime.versions.electron,
+		executable: runtime.execPath, profile: app.getPath("userData") });
+	app.on("before-quit", () => write("before-quit"));
+	app.on("will-quit", () => write("will-quit"));
+	app.on("quit", (_event, exitCode) => write("quit", { exitCode }));
+	app.on("browser-window-created", (_event, window) => {
+		window.on("close", () => write("window-close-request", { windowId: window.id }));
+		window.on("closed", () => write("window-closed", { windowId: window.id }));
+	});
+	app.on("render-process-gone", (_event, contents, details) =>
+		write("render-process-gone", { webContentsId: contents.id, reason: details.reason, exitCode: details.exitCode }));
+	app.on("child-process-gone", (_event, details) =>
+		write("child-process-gone", { type: details.type, reason: details.reason, exitCode: details.exitCode }));
+	runtime.on("uncaughtExceptionMonitor", (error, origin) =>
+		write("uncaught-exception", { name: error.name, origin }));
+	runtime.on("exit", (exitCode) => write("process-exit", { exitCode }));
+}

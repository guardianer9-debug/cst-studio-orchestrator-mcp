diff --git a/tests/lifecycleDiagnostics.test.mjs b/tests/lifecycleDiagnostics.test.mjs
new file mode 100644
index 0000000..bf04e42
--- /dev/null
+++ b/tests/lifecycleDiagnostics.test.mjs
@@ -0,0 +1,56 @@
+import assert from "node:assert/strict";
+import { EventEmitter } from "node:events";
+import { createRequire } from "node:module";
+import { mkdtempSync, readFileSync, readdirSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import test from "node:test";
+import vm from "node:vm";
+import ts from "typescript";
+
+const require = createRequire(import.meta.url);
+const sandbox = { exports: {}, require };
+vm.runInNewContext(ts.transpileModule(readFileSync("src/main/logging/lifecycleDiagnostics.ts", "utf8"), {
+  compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022 },
+}).outputText, sandbox);
+
+function start(profile) {
+  const app = Object.assign(new EventEmitter(), { getPath: () => profile, getVersion: () => "0.7.1" });
+  const runtime = Object.assign(new EventEmitter(), { pid: 123, versions: { electron: "38.8.6" }, execPath: "cst/electron.exe" });
+  sandbox.exports.registerLifecycleDiagnostics(app, runtime);
+  return { app, runtime };
+}
+
+test("exit events are persisted synchronously and do not suppress the normal exit path", () => {
+  const dir = mkdtempSync(join(tmpdir(), "cst-lifecycle-"));
+  try {
+    const { app, runtime } = start(dir);
+    const window = Object.assign(new EventEmitter(), { id: 7 });
+    app.emit("browser-window-created", {}, window);
+    window.emit("close");
+    app.emit("render-process-gone", {}, { id: 9 }, { reason: "oom", exitCode: -1 });
+    app.emit("child-process-gone", {}, { type: "GPU", reason: "crashed", exitCode: 3 });
+    runtime.emit("uncaughtExceptionMonitor", new Error("secret must not be copied"), "uncaughtException");
+    app.emit("before-quit");
+    window.emit("closed");
+    app.emit("will-quit");
+    app.emit("quit", {}, 0);
+    runtime.emit("exit", 0);
+    const text = readFileSync(join(dir, "logs", readdirSync(join(dir, "logs"))[0]), "utf8");
+    const rows = text.trim().split("\n").map(JSON.parse);
+    assert.deepEqual(rows.map(r => r.event), ["startup", "window-close-request", "render-process-gone", "child-process-gone", "uncaught-exception", "before-quit", "window-closed", "will-quit", "quit", "process-exit"]);
+    assert.equal(rows[2].reason, "oom");
+    assert.equal(rows.at(-1).exitCode, 0);
+    assert.equal(runtime.listenerCount("uncaughtException"), 0);
+    assert.ok(!text.includes("secret must not be copied"));
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});
+
+test("unwritable diagnostics do not prevent startup or shutdown", () => {
+  const dir = mkdtempSync(join(tmpdir(), "cst-lifecycle-failure-"));
+  try {
+    writeFileSync(join(dir, "logs"), "not a directory");
+    const { app, runtime } = start(dir);
+    assert.doesNotThrow(() => { app.emit("before-quit"); runtime.emit("exit", 1); });
+  } finally { rmSync(dir, { recursive: true, force: true }); }
+});

   "cst.connectivityReadOnly": "Grounds, probes and nets come from actual readback. Drag-to-rewire is not supported.",
   "cst.observedAt": "Readback observed at:",
   "cst.readResults": "Read existing results (no solve)",
@@ -41,7 +41,7 @@ export const enUS: Record<TranslationKey, string> = {
   "cst.apply": "Apply and read back",
   "cst.cadHint": "Actual CST-exported CAD surfaces. Drag to rotate, scroll to zoom. Not solver mesh.",
   "cst.opacity": "Opacity",
-  "cst.schematicHint": "Topology from actual Nets. See exact pin connections below; layout differs from native CST.",
+  "cst.schematicHint": "Topology from actual Nets. Numbers are API pin indices; see exact connections below. Layout differs from native CST.",
   "cst.noResults": "No curves are bound to this revision. Reference results are not treated as new results.",
   "cst.tab.3d": "3D model",
   "cst.tab.mesh": "Solver mesh",
